# Copy to .env and fill in as needed. docker-compose reads this automatically.

# API key the frontend/curl must send as the X-API-Key header.
AIDLC_API_KEY=dev-local-key

# Origin allowed to call the backend (CORS).
AIDLC_CORS_ORIGINS=http://localhost:8080

# Optional: enables live Groq-based evidence-statement extraction and the
# coordinator chatbot. Absent, both fall back to an unverified/stub response.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: OpenTelemetry export (Step 15). Absent, tracing/metrics no-op —
# the app is completely unaffected. Set OTEL_EXPORTER_OTLP_ENDPOINT to
# http://host.docker.internal:4317 to send to the standalone SigNoz stack
# started via `docker compose -f docker-compose.observability.yml up -d`.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=qualified-health-backend
