# ALCOA+ QA Management System - Production Environment
# Database Configuration for Testing (localhost)

VITE_DATABASE_HOST=localhost
VITE_DATABASE_PORT=5432
VITE_DATABASE_NAME=alcoa_qa_db
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000
VITE_ENV=production
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=error
VITE_ALCOA_ENFORCEMENT=true
