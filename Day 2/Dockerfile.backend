# Backend Dockerfile
# Builds and runs the ALCOA+ QA backend with rate limiting

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy backend source
COPY src/backend ./src/backend
COPY tsconfig.json ./
COPY tsconfig.node.json ./

# Build TypeScript
RUN npm run build:backend || echo "Using TypeScript without pre-build"

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://localhost:5000/health || exit 1

# Run backend
CMD ["node", "--loader", "ts-node/esm", "src/backend/app.ts"]
