# Backend Configuration for Rate Limiting
# Copy these values to .env.production for production deployment

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== Backend Server =====
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ===== CORS Configuration =====
CORS_ORIGIN=http://localhost:3000

# ===== Rate Limiting Global Settings =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE=redis  # Use 'redis' for production, 'memory' for dev

# ===== Rate Limit Configurations =====
# All rates are per window (minute or hour as specified)

# General API endpoints: 100 requests/minute per IP
GENERAL_REQUESTS_PER_MIN=100

# Login attempts: 10 failed attempts/hour per IP + username
# Includes exponential backoff starting at 1 second
LOGIN_ATTEMPTS_PER_HOUR=10
LOGIN_ATTEMPT_BACKOFF_START_MS=1000

# Record creation: 50 requests/minute per authenticated user
CREATE_REQUESTS_PER_MIN=50

# Report generation: 5 requests/minute per user
REPORT_REQUESTS_PER_MIN=5

# Audit trail export: 3 requests/minute per user
AUDIT_EXPORT_REQUESTS_PER_MIN=3

# Admin operations: 30 requests/minute per user
ADMIN_REQUESTS_PER_MIN=30

# Record approvals: 10 requests/minute per user
APPROVAL_REQUESTS_PER_MIN=10

# ===== JWT Configuration =====
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-here!!!!
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ===== Database Configuration =====
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=alcoa_qa_db
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# ===== Security Headers =====
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'

# ===== Logging =====
LOG_FORMAT=json  # 'json' or 'text'
LOG_LEVEL=info   # 'debug', 'info', 'warn', 'error'

# ===== Monitoring =====
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECK=true

# ===== Rate Limit Admin Access =====
# IP addresses allowed to access rate limit reset endpoints
ADMIN_IPS=127.0.0.1,::1

# ===== Development Only =====
DEBUG=false
MOCK_AUTH=false
