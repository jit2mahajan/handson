# ALCOA+ QA Management System - Development Environment
# Using localStorage and mock data

VITE_DATABASE_HOST=localhost
VITE_DATABASE_PORT=5432
VITE_DATABASE_NAME=alcoa_qa_db_dev
VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000
VITE_ENV=development
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug
VITE_ALCOA_ENFORCEMENT=true
VITE_AUDIT_TRAIL_ENABLED=true
VITE_CFR_PART_11_MODE=true
VITE_MOCK_DATA=true
VITE_ANALYTICS_ENABLED=false
VITE_ERROR_REPORTING=false
VITE_CACHE_ASSETS=false
VITE_MINIFY=false
VITE_SOURCE_MAPS=true
VITE_BRAND_COLOR_PRIMARY=#003366
VITE_BRAND_COLOR_ACCENT=#FFB81C
VITE_BRAND_COLOR_LIGHT=#E8EEF7
