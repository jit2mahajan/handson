{
  "name": "pharma-rag-governance",
  "version": "0.1.0",
  "description": "Governance layer for pharma agentic-RAG projects: allowlist enforcement, structured-output schema, escalation rules, and the backend/frontend/p3-triage subagents that operate under them.",
  "skills": ["skills/pharma-rag-principles"],
  "agents": ["agents/backend.md", "agents/frontend.md", "agents/p3-triage.md"],
  "hooks": {
    "PreToolUse": [
      { "matcher": "WebFetch|Bash|mcp__fetch__fetch", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/check_allowlist_retrieval.py\"" }] },
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/human_gate.py\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "WebFetch|Bash|mcp__fetch__fetch", "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR}/hooks/audit_retrieval_log.py\"" }] }
    ]
  },
  "requires": {
    "data_files": ["data/allowlist/sources.json", "data/schema/response_schema.json"]
  }
}
